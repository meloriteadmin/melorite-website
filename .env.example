# Canonical origin is fixed to https://melorite.com in src/data/site.ts.

# Enquiry email delivery (server-side only — never expose these values to the browser).
# Gmail: use smtp.gmail.com, port 465, secure true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Melorite Website <meloriteadmin@gmail.com>"
CONTACT_EMAIL=meloriteadmin@gmail.com

# Optional fallback when SMTP is not configured.
ENQUIRY_WEBHOOK_URL=
# Optional: HMAC-SHA256 signing secret; signature sent as `X-Melorite-Signature: sha256=<hex>`.
ENQUIRY_WEBHOOK_SECRET=

# Verified public contact details — these values are shown in the contact section and footer.
NEXT_PUBLIC_CONTACT_EMAIL=meloriteadmin@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=8482976478

# Approved legal pages — footer links only render when set.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Optional measurement. Set only after your analytics/privacy configuration is approved.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=
