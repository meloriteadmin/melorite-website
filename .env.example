# Public site URL — used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://melorite.com

# Enquiry / demo-request delivery (server-side only — never exposed to the browser).
# Required in production: enquiries are POSTed as JSON to this endpoint
# (e.g. a CRM intake endpoint or automation webhook). Without it, production
# submissions return 503 rather than showing a false success.
ENQUIRY_WEBHOOK_URL=
# Optional: HMAC-SHA256 signing secret; signature sent as `X-Melorite-Signature: sha256=<hex>`.
ENQUIRY_WEBHOOK_SECRET=

# Verified public contact details — these values are shown in the contact section and footer.
NEXT_PUBLIC_CONTACT_EMAIL=meloriteadmin@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=8482976478

# Approved legal pages — footer links only render when set.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
